# ---------------------------------------------------------------------------
# LLM provider. Any OpenAI-compatible chat completions endpoint works.
# Tested combinations below — uncomment one and add your key.
# ---------------------------------------------------------------------------

# Google Gemini (default — strongest Hindi/Devanagari output of the three)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=your_key_here

# Groq (fastest response times, good for the voice use case)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your_key_here

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.4
MAX_HISTORY_MESSAGES=40

# Seconds before a stuck provider call is abandoned (default 30).
REQUEST_TIMEOUT=30
